# LLM endpoint (OpenAI-compatible). Default = DeepInfra cloud, always behind the privacy gateway.
# Edge / fully offline: point at a local server instead, e.g. Ollama:
#   LLM_BASE_URL=http://localhost:11434/v1   DEEPINFRA_MODEL=llama3.1:8b
LLM_BASE_URL=https://api.deepinfra.com/v1/openai
# salt for patient pseudonyms (change per deployment)
PRIVACY_SALT=change-me
# DeepInfra (OpenAI-compatible). Without a key everything still runs on rule-based fallbacks.
DEEPINFRA_API_KEY=
# cheap default; alternatives: meta-llama/Llama-3.2-3B-Instruct, openai/gpt-oss-20b
DEEPINFRA_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# extra LLM expert that forecasts glucose from text (LLMTime-style). Off by default: ~17 calls per new forecast
# LLM_FORECASTER=1

# zero-shot forecaster weights (Hugging Face). chronos-bolt-tiny is faster, chronos-bolt-base more accurate
CHRONOS_MODEL=amazon/chronos-bolt-small
# DISABLE_CHRONOS=1   # use the damped-trend fallback instead

# PaPaGei PPG weights (bash scripts/get_papagei.sh puts them in weights/papagei_s.pt)
PPG_MODEL_PATH=
# DISABLE_PAPAGEI=1

# replay clock: seconds per tick
TICK_SECONDS=2
